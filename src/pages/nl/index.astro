---
// The page is 100% static content, so it is prerendered to a plain HTML file
// at build time: served from Cloudflare's asset layer with no per-request
// React SSR on the Worker (lower TTFB, HTML cacheable at the edge).
export const prerender = true;

// TEMPORARY: Dutch translations are being reworked and are disabled for now.
// To re-enable, uncomment the original code below, remove the redirect,
// and remove the `nl` filter in `src/components/react/language-switch.tsx`.
// return Astro.redirect("/", 302);

import Layout from "../../layouts/Layout.astro";
import NavIsland from "../../components/react/NavIsland";
import MainContentIsland from "../../components/react/MainContentIsland";
import ThemeSwitchIsland from "../../components/react/ThemeSwitchIsland";

// Update these once the Dutch copy is finalized (used for <title>/<meta description>).
const title = "Ian Hitchman | Persoonlijke Website";
const description =
	"Ian is een fullstack webontwikkelaar gevestigd in Arnhem, NL.";
---

<Layout title={title} description={description}>
	<NavIsland client:load lang="nl" pathname={Astro.url.pathname} />
	<MainContentIsland client:visible lang="nl" pathname={Astro.url.pathname} />
	<ThemeSwitchIsland client:idle />
</Layout>
