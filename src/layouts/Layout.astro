---
import "../styles/global.css";
import { languages, getLangFromUrl, getLocalizedPath } from "../i18n/utils";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Ian Hitchman | Personal Website",
	description = "Ian is a full-stack web developer based in Arnhem, NL.",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const canonicalURL = new URL(
	Astro.url.pathname,
	Astro.site ?? Astro.url.origin,
);
---

<!doctype html>
<html lang={lang} class="!scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
					return localStorage.getItem("theme");
				}
				if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					return "dark";
				}
				return "light";
			})();

			if (theme === "dark") {
				document.documentElement.classList.add("dark");
			} else {
				document.documentElement.classList.remove("dark");
			}

			// Engine/device classes, set before first paint (see src/lib/env.ts).
			// - `.webkit-engine`: the WebKit rendering engine — Safari on macOS
			//   and iOS, and every browser on iOS (they all run WebKit). Used to
			//   skip WebKit-slow effects (backdrop-filter) and to swap
			//   scroll-linked JS animations for one-shot ones.
			// - `.ios`: iOS/iPadOS device, regardless of browser.
			const ua = navigator.userAgent;
			const isWebKitEngine = /AppleWebKit/.test(ua) && !/Gecko\//.test(ua); // excludes Firefox
			const isIOS =
				/iPad|iPhone|iPod/.test(ua) ||
				(navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1); // iPadOS masquerades as macOS
			if (isWebKitEngine) {
				document.documentElement.classList.add("webkit-engine");
			}
			if (isIOS) {
				document.documentElement.classList.add("ios");
			}
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{
			Object.keys(languages).map((locale) => (
				<link
					rel="alternate"
					hreflang={locale}
					href={
						new URL(
							getLocalizedPath(
								Astro.url.pathname,
								locale as keyof typeof languages,
							),
							Astro.site ?? Astro.url.origin,
						)
					}
				/>
			))
		}
		<link
			rel="alternate"
			hreflang="x-default"
			href={new URL(
				getLocalizedPath(Astro.url.pathname, "en"),
				Astro.site ?? Astro.url.origin,
			)}
		/>
		<!-- Inter is self-hosted via @fontsource (see src/styles/global.css):
		     no render-blocking cross-origin stylesheet, no font round-trip. -->
	</head>
	<body
		class:list={[
			"font-[Inter] bg-gray-50 text-gray-950 relative dark:bg-gray-900 dark:text-gray-50 dark:text-opacity-90",
			lang === "nl" ? "pt-48 sm:pt-36" : "pt-40 sm:pt-36",
		]}
	>
		<div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
			<div
				class="bg-[#fbe2e3] absolute top-[-6rem] right-[11rem] h-[31.25rem] w-[31.25rem] rounded-full blur-[10rem] sm:w-[68.75rem] dark:bg-[#946263] transform-gpu"
			>
			</div>
			<div
				class="bg-[#dbd7fb] absolute top-[-1rem] left-[-35rem] h-[31.25rem] w-[50rem] rounded-full blur-[10rem] sm:w-[68.75rem] md:left-[-33rem] lg:left-[-28rem] xl:left-[-15rem] 2xl:left-[-5rem] dark:bg-[#676394] transform-gpu"
			>
			</div>
		</div>

		<slot />
	</body>
</html>
